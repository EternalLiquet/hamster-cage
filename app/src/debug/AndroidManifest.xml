<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- UI tooling must not add an externally launchable activity to an installable preview. -->
        <activity android:name="androidx.compose.ui.tooling.PreviewActivity" tools:node="remove" />
        <!-- Compose's instrumentation host runs inside the app; no external caller needs access. -->
        <activity android:name="androidx.activity.ComponentActivity" android:exported="false" tools:replace="android:exported" />
    </application>
</manifest>
